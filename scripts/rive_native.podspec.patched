#
# To learn more about a Podspec see http://guides.cocoapods.org/syntax/podspec.html.
# Run `pod lib lint rive_native.podspec` to validate before publishing.
#
Pod::Spec.new do |s|
  # Change to "debug" for debug builds (device only, simulator always uses emulator)
  rive_build_type = "release"

  s.name = "rive_native"
  s.version = "0.0.1"
  s.summary = "Rive Flutter's native iOS plugin"
  s.description = <<-DESC
Rive Flutter's native macOS plugin.
                       DESC
  s.homepage = "https://rive.app"
  s.license = { :file => "../LICENSE" }
  s.author = { "Rive" => "support@rive.app" }
  s.source = { :path => "." }
  # Source files in SPM-compatible directory structure
  s.source_files = "rive_native/Sources/rive_native/**/*.{h,mm}"
  s.public_header_files = "rive_native/Sources/rive_native/include/**/*.h"
  s.dependency "Flutter"
  s.platform = :ios, "9.0"
  s.ios.framework  = ['AudioToolbox', 'AVFAudio']

  # Fix: используем симлинк bin/active/, который переключается script_phase
  # (emulator/ для симулятора, release/ для устройства). См. scripts/README-rive-native-fix.md
  s.pod_target_xcconfig = { "DEFINES_MODULE" => "YES", "EXCLUDED_ARCHS[sdk=iphonesimulator*]" => "i386",
                            "USER_HEADER_SEARCH_PATHS" => '"$(PODS_TARGET_SRCROOT)/../native/include"',
                            "LIBRARY_SEARCH_PATHS" => '"$(PODS_TARGET_SRCROOT)/../native/build/iphoneos/bin/active"',
                            "OTHER_LDFLAGS" => '-Wl,-force_load,$(PODS_TARGET_SRCROOT)/../native/build/iphoneos/bin/active/librive_native.a -lrive -lrive_pls_renderer -lrive_yoga -lrive_harfbuzz -lrive_sheenbidi -lrive_decoders -llibpng -lzlib -llibjpeg -llibwebp -lminiaudio -lluau_vm -lluau_compiler -lluau_analyzer -lrive_scripting_workspace -lspirv_cross -lbrotli',
                            "CLANG_CXX_LANGUAGE_STANDARD" => "c++17",
                            "CLANG_CXX_LIBRARY" => "libc++" }

  script_setup = <<-SCRIPT_SETUP
  #!/bin/sh
  set -e
  MARKER="${PODS_TARGET_SRCROOT}/rive_marker_ios_setup_complete"
  DEV_MARKER="${PODS_TARGET_SRCROOT}/rive_marker_ios_development"
  if [ -f "$MARKER" ] || [ -f "$DEV_MARKER" ]; then
    echo "[rive_native] Setup already complete. Skipping."
  else
    echo "[rive_native] Setup marker not found. Running setup script..."
    echo "[rive_native] Run manually: dart run rive_native:setup --verbose --platform ios"
    GENERATED_XCCONFIG="${SRCROOT}/../Flutter/Generated.xcconfig"
    if [ -f "$GENERATED_XCCONFIG" ]; then
      FLUTTER_ROOT=$(grep FLUTTER_ROOT "$GENERATED_XCCONFIG" | cut -d '=' -f2 | tr -d '[:space:]')
    fi
    if [ -n "$FLUTTER_ROOT" ] && [ -x "$FLUTTER_ROOT/bin/dart" ]; then
      "$FLUTTER_ROOT/bin/dart" run rive_native:setup --verbose --platform ios
    else
      dart run rive_native:setup --verbose --platform ios
    fi
  fi
  SCRIPT_SETUP

  script_active = <<-SCRIPT_ACTIVE
  #!/bin/sh
  set -e
  SRC_BASE="${PODS_TARGET_SRCROOT}/../native/build/iphoneos/bin"
  if [ "$PLATFORM_NAME" = "iphonesimulator" ]; then
    ln -sfn "${SRC_BASE}/emulator" "${SRC_BASE}/active"
    echo "[rive_native] active -> emulator (simulator)"
  else
    ln -sfn "${SRC_BASE}/release" "${SRC_BASE}/active"
    echo "[rive_native] active -> release (device)"
  fi
  SCRIPT_ACTIVE

  s.script_phases = [
    {
      :name => 'Rive Active Symlink',
      :script => script_active,
      :execution_position => :before_compile
    },
    {
      :name => 'Rive Native Compile',
      :script => script_setup,
      :execution_position => :before_compile,
      :output_files => [
        '${PODS_TARGET_SRCROOT}/rive_marker_ios_setup_complete',
        '$(PODS_TARGET_SRCROOT)/../native/build/iphoneos/bin/active/librive_native.a'
      ]
    }
  ]
end
